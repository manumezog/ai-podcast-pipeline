# ── F5-TTS cloned host voice ──────────────────────────────────────────────
# Record ~10s of your voice and set the path + exact transcript below.
# Alex's lines will be synthesised in your cloned voice.
# Recommended: TTS_MAX_CHARS_PER_CHUNK=500 for reliable F5-TTS chunks.
F5_REF_AUDIO_PATH=C:\path\to\your_voice_sample.mp3
F5_REF_TEXT=The exact sentence you spoke in the recording above.

# F5_SERVER_URL: optional — point to your Google Colab ngrok tunnel for GPU speed.
# Leave empty to use local CPU inference (pip install f5-tts required).
# Format: https://xxxx-xx-xx-xx-xx.ngrok-free.app
F5_SERVER_URL=

# ── Google / Gemini (text generation + TTS) ───────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── NewsAPI ────────────────────────────────────────────────────────────────
NEWSAPI_KEY=your_newsapi_key_here

# ── Reddit / PRAW ──────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=podcaster/1.0 by your_reddit_username

# ── Podcast Identity ───────────────────────────────────────────────────────
SHOW_NAME=The Robotics Brief
HOST_NAME=Alex
TOPIC=robotics and automation

# ── Gemini TTS ─────────────────────────────────────────────────────────────
# Available voices: Aoede, Charon, Fenrir, Kore, Puck, Orbit, Zephyr
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Puck

# ── Cloudflare R2 (free audio hosting) ────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET_NAME=podcast
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ── GitHub (free RSS feed hosting via GitHub Pages) ────────────────────────
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO=yourusername/podcast-feed
GITHUB_RSS_PATH=feed.xml

# ── Podcast metadata ───────────────────────────────────────────────────────
PODCAST_DESCRIPTION=A daily podcast covering the latest in robotics and automation.
PODCAST_ARTWORK_URL=https://pub-xxxxxxxxxxxx.r2.dev/artwork.jpg
PODCAST_WEBSITE_URL=
PODCAST_CATEGORY=Technology
PODCAST_LANGUAGE=en-us
PODCAST_RSS_URL=https://yourusername.github.io/podcast-feed/feed.xml

# ── Notifications ─────────────────────────────────────────────────────────
# Gmail App Password: myaccount.google.com/apppasswords (requires 2FA on your Google account)
NOTIFICATION_EMAIL=your_email@gmail.com
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Pipeline repo where status/latest.json is pushed (used by monitoring routine)
GITHUB_PIPELINE_REPO=manumezog/ai-podcast-pipeline

# ── Gemini Text Model ─────────────────────────────────────────────────────
# gemini-2.5-flash = fast + cheap | gemini-2.5-pro = higher quality
GEMINI_MODEL=gemini-2.5-flash

# ── Episode Tuning ─────────────────────────────────────────────────────────
EPISODE_TARGET_WORDS=1500
CURATION_THRESHOLD=6
TOP_N_STORIES=5
TTS_MAX_CHARS_PER_CHUNK=4800

# ── Paths (override only if you move the output directories) ───────────────
DATA_DIR=data
SCRIPTS_DIR=scripts
AUDIO_DIR=audio
LOGS_DIR=logs
PROMPTS_DIR=prompts
SEEN_URLS_FILE=data/seen_urls.json
